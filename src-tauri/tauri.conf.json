{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoRequest",
  "version": "0.2.0",
  "identifier": "com.photorequest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoRequest",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Photo print orders",
    "longDescription": "Create portable photo print orders with exact sizes, quantities, paper finishes, and resolution checks. Open ZIP orders and prepare print-ready PDF sheets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English"]
      }
    }
  }
}
