{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Save ZIP and PDF files only to paths selected through a native Save dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
